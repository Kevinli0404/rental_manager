    {
      "name": "properties",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"properties\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"name\" TEXT NOT NULL, \"address\" TEXT NOT NULL DEFAULT '', \"note\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "inspections",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"inspections\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"property_id\" TEXT NOT NULL REFERENCES properties (id), \"type\" TEXT NOT NULL, \"status\" TEXT NOT NULL, \"inspected_on\" TEXT NOT NULL, \"landlord_name\" TEXT NOT NULL DEFAULT '', \"tenant_name\" TEXT NOT NULL DEFAULT '', \"layout_json\" TEXT NOT NULL, \"base_inspection_id\" TEXT NULL REFERENCES inspections (id), \"signed_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "item_results",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"item_results\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"inspection_id\" TEXT NOT NULL REFERENCES inspections (id), \"room_key\" TEXT NOT NULL, \"item_key\" TEXT NOT NULL, \"condition\" TEXT NULL, \"note\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"), UNIQUE (\"inspection_id\", \"room_key\", \"item_key\"));"
        }
      ]
    },
    {
      "name": "photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"photos\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"inspection_id\" TEXT NOT NULL REFERENCES inspections (id), \"room_key\" TEXT NOT NULL, \"item_key\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "signatures",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"signatures\" (\"id\" TEXT NOT NULL, \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, \"inspection_id\" TEXT NOT NULL REFERENCES inspections (id), \"role\" TEXT NOT NULL, \"relative_path\" TEXT NOT NULL, \"signed_at\" TEXT NOT NULL, PRIMARY KEY (\"id\"), UNIQUE (\"inspection_id\", \"role\"));"
        }
      ]
    }
